# --- App ---
NEXT_PUBLIC_APP_URL=https://getdecidia.com
ANON_SECRET=                      # secret HMAC du cookie d'analyse anonyme (openssl rand -base64 32)
CRON_SECRET=                      # Vercel l'envoie en Authorization: Bearer sur les crons

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # serveur uniquement

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-5-5
# Tarifs $/million de tokens pour le suivi de coût (à ajuster selon la grille Anthropic)
PRICE_ANALYSIS_IN=3
PRICE_ANALYSIS_OUT=15
PRICE_LIGHT_IN=1
PRICE_LIGHT_OUT=5
# DECIDIA_MOCK_AI=1               # réponses fixes, sans appel Anthropic (démo / tests)
# ENABLE_PREVIEW=1                # active /preview/<écran> (écrans avec données fictives) ; jamais en production

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=                 # 29 €/mois
STRIPE_PRICE_FOUNDER=             # tarif fondateur (100 premiers) ; facultatif : sans lui, tout le monde paie le prix Pro
# STRIPE_PRICE_ESSENTIAL=         # 9 €/mois  (désactivé dans le code)
# STRIPE_PRICE_TEAM=              # 79 €/mois (désactivé dans le code)

# --- E-mails ---
RESEND_API_KEY=
EMAIL_FROM="Decidia <hello@getdecidia.com>"

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
